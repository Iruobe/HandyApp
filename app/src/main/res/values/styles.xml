<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shared 12dp rounded shape — applied to buttons and inputs -->
    <style name="ShapeAppearance.HandyProject.Rounded" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius</item>
    </style>

    <!-- Primary button: teal filled, white text, 48dp tall, full width -->
    <style name="Widget.HandyProject.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HandyProject.Rounded</item>
    </style>

    <!-- Secondary button: teal outlined, teal text, 48dp tall, full width -->
    <style name="Widget.HandyProject.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HandyProject.Rounded</item>
    </style>

    <!-- Input field: white background, 12dp corners, teal focus highlight -->
    <style name="Widget.HandyProject.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">@color/colorCardBackground</item>
        <item name="boxStrokeColor">@color/input_stroke_color</item>
        <item name="hintTextColor">@color/colorTextSecondary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HandyProject.Rounded</item>
    </style>

    <!-- Ghost button: light grey fill, dark grey text, 12dp corners, 48dp tall, full width -->
    <style name="Widget.HandyProject.Button.Ghost" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="backgroundTint">@color/colorBackground</item>
        <item name="iconTint">@color/colorTextPrimary</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HandyProject.Rounded</item>
    </style>

    <!-- Card: white background, 12dp corners, 2dp elevation -->
    <style name="Widget.HandyProject.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/colorCardBackground</item>
    </style>

    <!-- Pill button: teal fill, white text, 36dp tall, pill corners, wrap_content width -->
    <style name="Widget.HandyProject.Button.Pill" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingStart">@dimen/padding_standard</item>
        <item name="android:paddingEnd">@dimen/padding_standard</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HandyProject.Rounded</item>
    </style>

    <!-- Agent banner button: white outline, white text, transparent background -->
    <style name="Widget.HandyProject.Button.Agent" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="strokeColor">@color/white</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HandyProject.Rounded</item>
    </style>


    <!-- Circular shape overlay — used on ShapeableImageView for profile photo -->
    <style name="ShapeAppearance.HandyProject.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

</resources>
