<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- TOP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/colorCardBackground"
        app:elevation="@dimen/card_elevation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_standard"
            android:paddingEnd="@dimen/padding_standard"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Confirm Booking"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:gravity="center" />

            <View
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true"
        android:background="@color/colorBackground"
        android:paddingBottom="@dimen/bottom_bar_height"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <!-- SECTION 1: Provider Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.HandyProject.Card"
                android:layout_marginBottom="@dimen/padding_standard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/padding_standard"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="@dimen/icon_container_size"
                        android:layout_height="@dimen/icon_container_size"
                        android:layout_marginEnd="@dimen/padding_standard">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivProviderPhoto"
                            android:layout_width="@dimen/icon_container_size"
                            android:layout_height="@dimen/icon_container_size"
                            android:src="@drawable/defaultprofile"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.HandyProject.Circle" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:background="@drawable/circle_filled"
                            android:src="@drawable/ic_verified"
                            app:tint="@color/white"
                            android:layout_gravity="bottom|end"
                            android:contentDescription="Verified"
                            android:visibility="gone" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProviderName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Marcus Johnson"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:id="@+id/tvProviderService"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Master Carpenter &amp; General Repair"
                            android:textSize="@dimen/text_size_body"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginTop="@dimen/margin_xsmall" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="@dimen/margin_xsmall">

                            <ImageView
                                android:layout_width="@dimen/icon_size_xs"
                                android:layout_height="@dimen/icon_size_xs"
                                android:src="@drawable/ic_star"
                                app:tint="@color/colorGold"
                                android:layout_marginEnd="@dimen/padding_xsmall"
                                android:contentDescription="Rating" />

                            <TextView
                                android:id="@+id/tvProviderRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.9"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 2: Job Details -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Job Details"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="@dimen/padding_small" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.HandyProject.Card"
                android:layout_marginBottom="@dimen/padding_standard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_standard">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SERVICE TYPE"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/colorTextSecondary"
                        android:textAllCaps="true"
                        android:layout_marginBottom="@dimen/padding_xsmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/padding_standard">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_tools"
                            app:tint="@color/colorPrimary"
                            android:layout_marginEnd="@dimen/padding_small"
                            android:contentDescription="Service type" />

                        <TextView
                            android:id="@+id/tvServiceType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="General Repair"
                            android:textSize="@dimen/text_size_body"
                            android:textColor="@color/colorTextPrimary" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESCRIPTION (OPTIONAL)"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/colorTextSecondary"
                        android:textAllCaps="true"
                        android:layout_marginBottom="@dimen/padding_xsmall" />

                    <EditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_input_multiline"
                        android:hint="Describe the job in detail..."
                        android:inputType="textMultiLine"
                        android:background="@drawable/bg_input_rounded"
                        android:padding="@dimen/padding_standard"
                        android:gravity="top|start" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 3: Date & Time -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Date &amp; Time"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="@dimen/padding_small" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.HandyProject.Card"
                android:layout_marginBottom="@dimen/padding_standard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_standard">

                    <!-- Month/year nav row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/padding_standard">

                        <TextView
                            android:id="@+id/tvMonthYear"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="June 2026"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <ImageButton
                            android:id="@+id/btnPrevMonth"
                            android:layout_width="@dimen/back_button_size"
                            android:layout_height="@dimen/back_button_size"
                            android:src="@drawable/ic_arrow_back"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="@color/colorTextSecondary"
                            android:contentDescription="Previous month" />

                        <ImageButton
                            android:id="@+id/btnNextMonth"
                            android:layout_width="@dimen/back_button_size"
                            android:layout_height="@dimen/back_button_size"
                            android:src="@drawable/ic_arrow_drop_down"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="@color/colorTextSecondary"
                            android:rotation="-90"
                            android:contentDescription="Next month" />

                    </LinearLayout>

                    <!-- Date chips (populated programmatically) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutDateChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" />

                    </HorizontalScrollView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:background="@color/colorUnselectedBackground"
                        android:layout_marginTop="@dimen/padding_standard"
                        android:layout_marginBottom="@dimen/padding_standard" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVAILABLE TIMES"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/colorTextSecondary"
                        android:textAllCaps="true"
                        android:layout_marginBottom="@dimen/padding_small" />

                    <!-- Time chips (populated programmatically) -->
                    <LinearLayout
                        android:id="@+id/layoutTimeChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 4: Location -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="@dimen/padding_small" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.HandyProject.Card"
                android:layout_marginBottom="@dimen/padding_standard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_standard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_location"
                            app:tint="@color/colorPrimary"
                            android:layout_marginEnd="@dimen/padding_small"
                            android:contentDescription="Location" />

                        <EditText
                            android:id="@+id/etAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Enter service address"
                            android:inputType="text"
                            android:background="@null"
                            android:textSize="@dimen/text_size_body" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:background="@color/colorUnselectedBackground"
                        android:layout_marginTop="@dimen/padding_small"
                        android:layout_marginBottom="@dimen/padding_small" />

                    <TextView
                        android:id="@+id/tvUseCurrentLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Use current location"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/colorPrimary"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 5: Payment Summary -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payment Summary"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="@dimen/padding_small" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.HandyProject.Card"
                android:layout_marginBottom="@dimen/padding_standard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_standard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hourly Rate"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:id="@+id/tvHourlyRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="£65.00/hr"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimary" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_xsmall"
                        android:text="Final price confirmed by handyman"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/colorTextSecondary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:background="@color/colorUnselectedBackground"
                        android:layout_marginTop="@dimen/padding_standard"
                        android:layout_marginBottom="@dimen/padding_standard" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAYMENT METHOD"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/colorTextSecondary"
                        android:textAllCaps="true"
                        android:layout_marginBottom="@dimen/padding_small" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_passkey"
                            app:tint="@color/colorTextPrimary"
                            android:layout_marginEnd="@dimen/padding_small"
                            android:contentDescription="Payment method" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="•••• 4242"
                            android:textSize="@dimen/text_size_body"
                            android:textColor="@color/colorTextPrimary" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_xs"
                            android:layout_height="@dimen/icon_size_xs"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/colorTextSecondary"
                            android:rotation="-90"
                            android:contentDescription="Change payment" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FIXED BOTTOM BAR -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorCardBackground"
        android:elevation="@dimen/card_elevation_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Free cancellation up to 24h before. Cancellation Policy."
                android:textSize="@dimen/text_size_caption"
                android:textColor="@color/colorTextSecondary"
                android:gravity="center"
                android:layout_marginBottom="@dimen/padding_small" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmBooking"
                style="@style/Widget.HandyProject.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Confirm Booking" />

        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
