<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".ui.handyman.HandymanHomeActivity">

    <!-- Fixed top bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/colorCardBackground"
        app:elevation="@dimen/card_elevation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/padding_standard"
            android:paddingEnd="@dimen/padding_standard">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:src="@drawable/defaultprofile"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_avatar_bg"
                    android:contentDescription="User avatar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_small"
                    android:text="Handy"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_subheading"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNotifications"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:src="@drawable/ic_notifications"
                android:background="@android:color/transparent"
                android:contentDescription="Notifications" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/colorBackground"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <!-- SECTION 1: Profile Completion Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileCompletion"
                style="@style/Widget.HandyProject.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_standard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_standard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Complete your profile"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/tvProfileCompletionPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="75%"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/padding_small"
                        android:text="Add portfolio photos to attract more customers."
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_body"
                        android:fontFamily="sans-serif" />

                    <ProgressBar
                        android:id="@+id/progressProfileCompletion"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/padding_small"
                        android:layout_marginTop="@dimen/padding_small"
                        android:max="100"
                        android:progress="75"
                        android:progressTint="@color/colorPrimary"
                        android:progressBackgroundTint="@color/colorUnselectedBackground" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddPhotos"
                        style="@style/Widget.HandyProject.Button.Pill"
                        android:layout_marginTop="@dimen/padding_standard"
                        android:text="Add Photos" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 2: Stats Grid — Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="@dimen/padding_small">

                <!-- Card 1: Availability -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HandyProject.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/padding_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_standard">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/icon_size"
                                android:layout_height="@dimen/icon_size"
                                android:layout_weight="1"
                                android:src="@drawable/ic_calendar"
                                android:contentDescription="Availability" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchAvailability"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:trackTint="@drawable/switch_track_color"
                                app:thumbTint="@color/white" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/padding_standard"
                            android:text="STATUS"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_caption"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/tvAvailabilityStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_xsmall"
                            android:text="Available"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Total Jobs -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HandyProject.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/padding_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_standard">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_briefcase"
                            android:contentDescription="Total jobs" />

                        <TextView
                            android:id="@+id/tvTotalJobs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/padding_small"
                            android:text="42"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_heading"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Jobs"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_caption"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Stats Grid — Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="@dimen/padding_standard">

                <!-- Card 3: Rating -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HandyProject.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/padding_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_standard">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_star"
                            android:tint="@color/colorGold"
                            android:contentDescription="Rating" />

                        <TextView
                            android:id="@+id/tvRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/padding_small"
                            android:text="4.9"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_heading"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rating"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_caption"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 4: Views -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HandyProject.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/padding_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_standard">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_visibility"
                            android:contentDescription="Profile views" />

                        <TextView
                            android:id="@+id/tvProfileViews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/padding_small"
                            android:text="1.2k"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_heading"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Views"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_caption"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- SECTION 3: Recent Portfolio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/padding_small">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Portfolio"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/text_size_subheading"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tvViewAllPortfolio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_body"
                    android:fontFamily="sans-serif"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="@dimen/padding_standard">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_portfolio"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/padding_small"
                    app:cardCornerRadius="@dimen/corner_radius"
                    app:cardElevation="@dimen/card_elevation">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/colorUnselectedBackground"
                        android:src="@drawable/defaultprofile"
                        android:contentDescription="Portfolio photo 1" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_portfolio"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/padding_small"
                    app:cardCornerRadius="@dimen/corner_radius"
                    app:cardElevation="@dimen/card_elevation">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/colorUnselectedBackground"
                        android:src="@drawable/defaultprofile"
                        android:contentDescription="Portfolio photo 2" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- SECTION 4: Recent Enquiries -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HandyProject.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/padding_standard"
                        android:paddingEnd="@dimen/padding_standard"
                        android:paddingTop="@dimen/padding_standard"
                        android:paddingBottom="@dimen/padding_small">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Recent Enquiries"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/tvNewBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 New"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_caption"
                            android:fontFamily="sans-serif"
                            android:paddingStart="@dimen/padding_xsmall"
                            android:paddingEnd="@dimen/padding_xsmall"
                            android:paddingTop="@dimen/margin_xsmall"
                            android:paddingBottom="@dimen/margin_xsmall" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:background="@color/colorUnselectedBackground" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEnquiries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAllEnquiries"
                        style="@style/Widget.HandyProject.Button.Secondary"
                        android:layout_margin="@dimen/padding_standard"
                        android:text="View All Enquiries" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorCardBackground"
        app:elevation="@dimen/card_elevation_large"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
