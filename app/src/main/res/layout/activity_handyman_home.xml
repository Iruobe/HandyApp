<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".ui.handyman.HandymanHomeActivity">

    <!-- Fixed top bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/colorCardBackground"
        app:elevation="@dimen/card_elevation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/padding_standard"
            android:paddingEnd="@dimen/padding_standard">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:src="@drawable/defaultprofile"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_avatar_bg"
                    android:contentDescription="User avatar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_small"
                    android:text="Handy"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_subheading"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNotifications"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:src="@drawable/ic_notifications"
                android:background="@android:color/transparent"
                android:contentDescription="Notifications" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/colorBackground"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <!-- Stats grid: Rating (visible, full-width) + Total Jobs (hidden until Round 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="@dimen/padding_standard">

                <!-- Rating -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HandyProject.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/padding_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_standard">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_star"
                            android:tint="@color/colorGold"
                            android:contentDescription="Rating" />

                        <TextView
                            android:id="@+id/tvRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/padding_small"
                            android:text="Not rated"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_heading"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rating"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_caption"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Total Jobs — wired to the count of confirmed bookings (Round 2) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HandyProject.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/padding_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_standard">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_briefcase"
                            android:contentDescription="Total jobs" />

                        <TextView
                            android:id="@+id/tvTotalJobs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/padding_small"
                            android:text="0"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_heading"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Jobs"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_caption"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Recent Enquiries — list hidden this round (B1); card shell + button kept -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HandyProject.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/padding_standard"
                        android:paddingEnd="@dimen/padding_standard"
                        android:paddingTop="@dimen/padding_standard"
                        android:paddingBottom="@dimen/padding_small">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Recent Enquiries"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <!-- Count of pending bookings among the recent 3; GONE when zero (set in code) -->
                        <TextView
                            android:id="@+id/tvNewBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 New"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_caption"
                            android:fontFamily="sans-serif"
                            android:paddingStart="@dimen/padding_xsmall"
                            android:paddingEnd="@dimen/padding_xsmall"
                            android:paddingTop="@dimen/margin_xsmall"
                            android:paddingBottom="@dimen/margin_xsmall"
                            android:visibility="gone" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:background="@color/colorUnselectedBackground" />

                    <!-- Recent Enquiries — this handyman's last 3 bookings (Round 2) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEnquiries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAllEnquiries"
                        style="@style/Widget.HandyProject.Button.Secondary"
                        android:layout_margin="@dimen/padding_standard"
                        android:text="View All Enquiries" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorCardBackground"
        app:elevation="@dimen/card_elevation_large"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
