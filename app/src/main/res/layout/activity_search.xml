<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Top bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorCardBackground"
        app:elevation="@dimen/card_elevation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/padding_standard"
            android:paddingEnd="@dimen/padding_standard">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:src="@drawable/ic_arrow_back"
                android:background="@android:color/transparent"
                android:layout_marginEnd="@dimen/padding_small"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Search Results"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

        <!-- Filter chips row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/colorCardBackground"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_small"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_small">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Chip: Location -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_chip"
                    android:layout_marginEnd="@dimen/padding_small"
                    app:cardCornerRadius="@dimen/corner_radius_pill"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    app:strokeWidth="@dimen/divider_height"
                    app:strokeColor="@color/colorUnselectedBorder">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/padding_small"
                        android:paddingEnd="@dimen/padding_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textSize="@dimen/text_size_caption"
                            android:textColor="@color/colorTextPrimary"
                            android:fontFamily="sans-serif"/>

                        <ImageView
                            android:layout_width="@dimen/icon_size_xs"
                            android:layout_height="@dimen/icon_size_xs"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/colorTextSecondary"
                            android:contentDescription="Expand"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chip: Service Type (active/teal) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipServiceType"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_chip"
                    android:layout_marginEnd="@dimen/padding_small"
                    app:cardCornerRadius="@dimen/corner_radius_pill"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/colorPrimary"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/padding_small"
                        android:paddingEnd="@dimen/padding_small">

                        <TextView
                            android:id="@+id/tvActiveFilter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All Services"
                            android:textSize="@dimen/text_size_caption"
                            android:textColor="@color/white"
                            android:fontFamily="sans-serif"/>

                        <ImageView
                            android:id="@+id/btnClearFilter"
                            android:layout_width="@dimen/icon_size_xs"
                            android:layout_height="@dimen/icon_size_xs"
                            android:src="@drawable/ic_close"
                            app:tint="@color/white"
                            android:contentDescription="Clear filter"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chip: Price -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_chip"
                    android:layout_marginEnd="@dimen/padding_small"
                    app:cardCornerRadius="@dimen/corner_radius_pill"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    app:strokeWidth="@dimen/divider_height"
                    app:strokeColor="@color/colorUnselectedBorder">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/padding_small"
                        android:paddingEnd="@dimen/padding_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price"
                            android:textSize="@dimen/text_size_caption"
                            android:textColor="@color/colorTextPrimary"
                            android:fontFamily="sans-serif"/>

                        <ImageView
                            android:layout_width="@dimen/icon_size_xs"
                            android:layout_height="@dimen/icon_size_xs"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/colorTextSecondary"
                            android:contentDescription="Expand"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chip: Rating -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipRating"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_chip"
                    app:cardCornerRadius="@dimen/corner_radius_pill"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    app:strokeWidth="@dimen/divider_height"
                    app:strokeColor="@color/colorUnselectedBorder">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/padding_small"
                        android:paddingEnd="@dimen/padding_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rating"
                            android:textSize="@dimen/text_size_caption"
                            android:textColor="@color/colorTextPrimary"
                            android:fontFamily="sans-serif"/>

                        <ImageView
                            android:layout_width="@dimen/icon_size_xs"
                            android:layout_height="@dimen/icon_size_xs"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/colorTextSecondary"
                            android:contentDescription="Expand"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Sort row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/padding_standard"
            android:paddingEnd="@dimen/padding_standard"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_small"
            android:background="@color/colorBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort by:"
                android:textSize="@dimen/text_size_caption"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginEnd="@dimen/padding_small"
                android:fontFamily="sans-serif"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_radius"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeWidth="@dimen/divider_height"
                app:strokeColor="@color/colorUnselectedBorder">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:paddingTop="@dimen/padding_xsmall"
                    android:paddingBottom="@dimen/padding_xsmall">

                    <TextView
                        android:id="@+id/tvSortBy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recommended"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginEnd="@dimen/padding_xsmall"
                        android:fontFamily="sans-serif"/>

                    <ImageView
                        android:layout_width="@dimen/icon_size_xs"
                        android:layout_height="@dimen/icon_size_xs"
                        android:src="@drawable/ic_sort"
                        app:tint="@color/colorTextSecondary"
                        android:contentDescription="Sort"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Results count -->
            <TextView
                android:id="@+id/tvResultsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/colorTextSecondary"
                android:paddingStart="@dimen/padding_standard"
                android:paddingEnd="@dimen/padding_standard"
                android:paddingTop="@dimen/padding_standard"
                android:paddingBottom="@dimen/padding_xsmall"
                android:fontFamily="sans-serif"/>

            <!-- Results list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="@dimen/padding_small"/>

            <!-- Load more -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoadMore"
                style="@style/Widget.HandyProject.Button.Secondary"
                android:layout_margin="@dimen/padding_standard"
                android:text="Load More"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorCardBackground"
        app:elevation="@dimen/card_elevation_large"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:menu="@menu/bottom_nav_menu"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
