<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".ui.customer.CustomerHomeActivity">

    <!-- Fixed top bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/colorCardBackground"
        app:elevation="@dimen/card_elevation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/padding_standard"
            android:paddingEnd="@dimen/padding_standard">

            <ImageView
                android:id="@+id/ivUserAvatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:src="@drawable/defaultprofile"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_avatar_bg"
                android:contentDescription="User avatar" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Handy"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <ImageButton
                android:id="@+id/btnNotifications"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:src="@drawable/ic_notifications"
                android:background="@android:color/transparent"
                android:contentDescription="Notifications" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/colorBackground"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <!-- Greeting -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello there"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_heading"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_xsmall"
                android:text="What do you need help with today?"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_size_body"
                android:fontFamily="sans-serif" />

            <!-- Search bar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                app:cardCornerRadius="@dimen/corner_radius_pill"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorUnselectedBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_small">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:layout_marginStart="@dimen/padding_medium"
                        android:src="@drawable/ic_search"
                        android:contentDescription="Search" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/padding_small"
                        android:layout_marginEnd="@dimen/padding_medium"
                        android:background="@android:color/transparent"
                        android:hint="Search services (e.g. Plumbing, Electrical)"
                        android:textColorHint="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_body"
                        android:fontFamily="sans-serif"
                        android:singleLine="true"
                        android:inputType="text" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI Agent Banner (gradient applied in Java on layoutAgentBanner) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAgentBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                app:cardCornerRadius="@dimen/corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:id="@+id/layoutAgentBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/padding_standard">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not sure who to hire?"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/padding_xsmall"
                            android:text="Describe your issue and our AI assistant will match you with the right professional."
                            android:textColor="@color/white"
                            android:alpha="0.85"
                            android:textSize="@dimen/text_size_body"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetStarted"
                        style="@style/Widget.HandyProject.Button.Agent"
                        android:layout_marginStart="@dimen/padding_standard"
                        android:text="Get Started" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Post card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                app:cardCornerRadius="@dimen/corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeColor="@color/colorUnselectedBackground"
                app:strokeWidth="@dimen/divider_height">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_standard">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Post"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_size_subheading"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <!-- Upload area -->
                    <LinearLayout
                        android:id="@+id/layoutUpload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/padding_standard"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/padding_large"
                        android:background="@drawable/bg_upload_area">

                        <ImageView
                            android:layout_width="@dimen/back_button_size"
                            android:layout_height="@dimen/back_button_size"
                            android:src="@drawable/ic_upload"
                            android:background="@drawable/circle_unselected_bg"
                            android:padding="@dimen/padding_small"
                            android:contentDescription="Upload photo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/padding_small"
                            android:text="Tap to upload a photo or description"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_body"
                            android:gravity="center"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/padding_xsmall"
                            android:text="JPEG, PNG up to 10MB"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_caption"
                            android:gravity="center"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                    <!-- Budget label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/padding_small"
                        android:text="Estimated Budget (Optional)"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_caption"
                        android:fontFamily="sans-serif" />

                    <!-- Budget input row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/padding_xsmall"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/padding_xsmall"
                            android:text="£"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_body"
                            android:fontFamily="sans-serif" />

                        <EditText
                            android:id="@+id/etBudget"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="0.00"
                            android:inputType="numberDecimal"
                            android:background="@drawable/bg_input_rounded"
                            android:padding="@dimen/padding_small"
                            android:textSize="@dimen/text_size_body"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFindHandymen"
                        style="@style/Widget.HandyProject.Button.Primary"
                        android:layout_marginTop="@dimen/padding_small"
                        android:text="Find Handymen" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Available Near You header -->
            <LinearLayout
                android:id="@+id/layoutAvailableHandymen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Available Near You"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/text_size_subheading"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tvSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_body"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- Horizontal handyman RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHandymen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:clipToPadding="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorCardBackground"
        app:elevation="@dimen/card_elevation_large"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
